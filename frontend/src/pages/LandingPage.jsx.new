    {
      name: 'Emily Rodriguez',
      position: 'UX Designer',
      company: 'Apple',
      avatar: 'https://randomuser.me/api/portraits/women/3.jpg',
      text: 'The quality of job listings on TopHire is exceptional. I found opportunities that were not listed anywhere else.'
